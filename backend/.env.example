# =====================================================================
# AI Farmer Advisory System — Environment Template
# Copy this to .env and fill in your real values.
# This file IS safe to commit. Do NOT commit .env
# =====================================================================

OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json
DATABASE_URL=postgresql+asyncpg://postgres:password@db:5432/farmerdb
CHROMA_PERSIST_PATH=./chroma_store
COLLECTION_NAME=agri_knowledge
ENV=development
APP_NAME=AI Farmer Advisory System
APP_VERSION=1.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=300
RAG_TOP_K=4
CHUNK_SIZE=500
CHUNK_OVERLAP=50
CACHE_TTL_SECONDS=300
USE_INDICTRANS2=true
USE_VOICE=true
