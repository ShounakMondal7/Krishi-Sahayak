{
  "expo": {
    "name": "Krishi Sahayak",
    "slug": "krishi-sahayak",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "krishisahayak",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D1B12"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.krishisahayak.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D1B12"
      },
      "package": "com.krishisahayak.app",
      "permissions": [
        "RECORD_AUDIO",
        "INTERNET",
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiUrl": "http://localhost:8000",
      "eas": {
        "projectId": "your-project-id"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-av",
        {
          "microphonePermission": "Allow Krishi Sahayak to access your microphone for voice queries."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Krishi Sahayak to access your photos to analyze crop images.",
          "cameraPermission": "Allow Krishi Sahayak to use your camera to photograph crops for disease analysis."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
